#!/usr/bin/env expect
# Drives `payload migrate:create` through a real pseudo-terminal so its
# interactive "is this a rename or a new column?" prompts can actually be
# answered (they require a real TTY; plain piped stdin doesn't work).
#
# Always selects the first/default option at every such prompt, which is
# "+ <name> create column" — i.e. treat every ambiguous case as a genuinely
# new column, never a rename. That's correct for this project: every field
# that's changed shape this session is a real conceptual change, not a
# rename that should carry old data into a differently-purposed column.
#
# Usage: expect scripts/migrate-create.exp <migration-name>

set timeout 60
set migration_name [lindex $argv 0]

spawn pnpm payload migrate:create $migration_name

expect {
  -re {created or renamed from another (column|table)\?.*\n} {
    send "\r"
    exp_continue
  }
  timeout {
    puts "\n---MIGRATE_CREATE_TIMEOUT---"
    exit 1
  }
  eof
}

catch wait result
set exit_code [lindex $result 3]
puts "\n---MIGRATE_CREATE_EXIT_CODE:$exit_code---"
exit $exit_code
